<resources xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="https://developer.garmin.com/downloads/connect-iq/resources.xsd">

    <properties>
        <!-- 0 = time in CURRENT zone (switches live), 1 = time in a fixed TARGET zone -->
        <property id="mode" type="number">0</property>
        <!-- Which zone to track in mode 1 (1..5). Default Z2 for base-mile tracking. -->
        <property id="targetZone" type="number">2</property>
    </properties>

    <settings>
        <setting propertyKey="@Properties.mode" title="@Strings.modeTitle">
            <settingConfig type="list">
                <listEntry value="0">@Strings.modeCurrent</listEntry>
                <listEntry value="1">@Strings.modeTarget</listEntry>
            </settingConfig>
        </setting>

        <setting propertyKey="@Properties.targetZone" title="@Strings.targetZoneTitle">
            <settingConfig type="numeric" min="1" max="5" />
        </setting>
    </settings>

</resources>
