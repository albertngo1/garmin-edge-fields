import Toybox.Lang;

// Native activity palette for Edge 550 / 850 (dark bg #191919, else as 1050).
module Palette {
    const LIGHT_BG   = 0xDCDCDC;
    const DARK_BG    = 0x191919;
    const LIGHT_TEXT = 0x313253;
    const DARK_TEXT  = 0xFFFFFF;

    // Subtle native light-cell sheen (see e1050 Palette). Same light bg as 1050.
    const LIGHT_BG_TOP = 0xE2E2E2;
    const LIGHT_BG_BOT = 0xD2D2D2;
}
