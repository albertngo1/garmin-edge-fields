project.manifest = manifest.xml

# Shared source for every device.
base.sourcePath = source

# Per-device native palette (each device's personality.mss differs). One Palette
# module is compiled in per device; tools/check_native_palette.py verifies each
# variant against that device's profile.
edge1050.sourcePath     = $(base.sourcePath);source-palette/e1050
edge550.sourcePath      = $(base.sourcePath);source-palette/x50
edge850.sourcePath      = $(base.sourcePath);source-palette/x50
edge540.sourcePath      = $(base.sourcePath);source-palette/mono
edge840.sourcePath      = $(base.sourcePath);source-palette/mono
edgeexplore2.sourcePath = $(base.sourcePath);source-palette/mono
edgemtb.sourcePath      = $(base.sourcePath);source-palette/mono
