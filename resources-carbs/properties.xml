<resources xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="https://developer.garmin.com/downloads/connect-iq/resources.xsd">

    <properties>
        <!-- Functional threshold power (watts); intensity as a % of this sets the carb fraction. -->
        <property id="ftp" type="number">200</property>
    </properties>

    <settings>
        <setting propertyKey="@Properties.ftp" title="@Strings.ftpTitle">
            <settingConfig type="numeric" min="50" max="600" />
        </setting>
    </settings>

</resources>
